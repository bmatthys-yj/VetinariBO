{
  "name": "vetinari-bo",
  "version": "0.1.0",
  "description": "Backoffice for tracking Vetinari clients, leads, workshops, and repositories.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:app",
    "build:app": "vite build app",
    "build:server": "tsc -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "rm -rf dist",
    "db:migrate": "pnpm run build:server && node dist/db/migrate.js",
    "dev": "vite app",
    "dev:server": "pnpm run build:server && node --watch dist/server/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p app/tsconfig.json --noEmit",
    "db:add-workshop": "pnpm run build:server && node dist/scripts/addWorkshop.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.3",
    "@tanstack/react-router": "^1.170.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.13.7",
    "kysely": "^0.28.17",
    "lucide-react": "^1.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.22.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.2",
    "vite": "^8.2.2",
    "vitest": "^3.0.8"
  }
}
