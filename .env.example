# Path to the local SQLite database file.
VETINARI_BO_DATABASE_FILE=./data/vetinari-bo.db

# Backoffice server. Bound to loopback by default so it is not reachable from
# the network; only the public form below is meant to be exposed.
VETINARI_BO_PORT=3100
VETINARI_BO_HOST=127.0.0.1

# Public enrollment form server.
VETINARI_BO_PUBLIC_PORT=3101
VETINARI_BO_PUBLIC_HOST=0.0.0.0

# Origin the enrollment form is reachable at. Used to build the links the
# backoffice shows, so set this to the public hostname once deployed.
VETINARI_BO_PUBLIC_BASE_URL=http://localhost:3101

# Trust x-forwarded-for when rate limiting. Only enable behind a proxy you
# control: the header is trivially spoofed on a directly exposed server.
VETINARI_BO_TRUST_PROXY=false

# LiteLLM gateway the agents send their model requests through. By default this
# is Vetinari's gateway, shared by both apps: start it from the Vetinari repo and
# create a backoffice virtual key in its dashboard at http://localhost:4000/ui/.
VETINARI_BO_LITELLM_BASE_URL=http://localhost:4000

# The virtual key created in the LiteLLM dashboard. Agents cannot run until
# this is set; the Agents page shows the gateway as not configured.
VETINARI_BO_LITELLM_API_KEY=

# Model deployment the built-in agents use, as named in the LiteLLM dashboard.
VETINARI_BO_LITELLM_MODEL=

# Only for running a separate gateway with `pnpm litellm:up`. It bootstraps that
# gateway's admin UI (username `admin`); never use it as the key above. Vetinari's
# gateway holds port 4000, so pick another port and point the base URL above at it.
LITELLM_UI_MASTER_KEY=
# LITELLM_PORT=4001

# Pappers International API token (https://www.pappers.in/api), used by the
# Pappers agent's tools. Every request costs Pappers credits.
VETINARI_BO_PAPPERS_API_TOKEN=
